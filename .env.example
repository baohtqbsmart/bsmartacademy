# Copy to .env.local and fill in. Never commit .env.local.

# Public URL of this app (used in auth email links).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase project: Dashboard -> Project Settings -> API Keys.
# For the local stack, `npx supabase status` prints both values.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# AI teaching assistant (server only; never prefix these with NEXT_PUBLIC_).
# AI_PROVIDER: anthropic (default) or none to switch the assistant off.
# Leave AI_API_KEY empty and the assistant says it is not set up.
AI_PROVIDER=anthropic
AI_API_KEY=
# Optional: model id (default claude-sonnet-5) and per-request timeout in ms.
AI_MODEL=
AI_TIMEOUT_MS=90000
